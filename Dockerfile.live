# The online server, h2live, for a host online such as Render (render.yaml,
# docs/ONLINE.md). It's built from the crates it needs, and .dockerignore
# keeps everything else out, map files above all: the server never reads
# one.
#
#   docker build -f Dockerfile.live -t h2live .
#   docker run -p 47050:47050 -p 47050:47050/udp h2live
#
# A host sets PORT, and h2live listens there instead. The relay for the
# launcher's games listens on UDP at the same port number (H2LIVE_RELAY
# changes it); a host that only carries TCP, like Render's free web
# services, can't reach it.

FROM rust:1.99-slim-trixie AS build
WORKDIR /src
COPY . .
# The workspace has the game, h2tool, the launcher and its menus in it too.
# Cargo only needs them to be there, not built, so they're left as empty
# programs and an empty library.
RUN for c in h2launch h2tool h2viewer; do \
        mkdir -p crates/$c/src && echo 'fn main() {}' > crates/$c/src/main.rs; \
    done && \
    mkdir -p crates/h2ui/src && touch crates/h2ui/src/lib.rs
RUN cargo build --release --locked -p h2live

FROM debian:trixie-slim
RUN useradd --create-home h2live
USER h2live
# Accounts are kept in h2live-data here unless H2LIVE_DATA says otherwise.
WORKDIR /home/h2live
COPY --from=build /src/target/release/h2live /usr/local/bin/h2live
# There's no router to ask for the port from inside a container.
ENV H2LIVE_UPNP=0
EXPOSE 47050/tcp 47050/udp
CMD ["h2live"]
